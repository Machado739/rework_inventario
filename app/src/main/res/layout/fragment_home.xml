<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/listaContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.7"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seleccionar Registro"
                android:textAlignment="center"
                android:textSize="20sp" />

            <FrameLayout
                android:id="@+id/divisor3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#3F51B5">

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="10dp" />
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/registrosRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/capturaLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <FrameLayout
                android:id="@+id/precargadosFLY"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:foregroundGravity="center">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/textView6"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CODIGO"
                                    android:textSize="20sp" />

                                <AutoCompleteTextView
                                    android:id="@+id/AutoCompleteListaCodigos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:completionThreshold="1"
                                    android:hint="Buscar Producto"
                                    tools:text="          " />
                            </LinearLayout>

                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:foregroundGravity="center">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/textView9"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="UBICACION"
                                    android:textSize="20sp" />

                                <Spinner
                                    android:id="@+id/ubicacionSPN"
                                    android:layout_width="150dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:popupElevation="14dp" />
                            </LinearLayout>

                        </FrameLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:foregroundGravity="center">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/textView7"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="EMPRESA"
                                    android:textSize="20sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:forceHasOverlappingRendering="false"
                                    android:orientation="horizontal">

                                    <Button
                                        android:id="@+id/cosmarBTN"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="COSMAR"
                                        android:textSize="8sp" />

                                    <Space
                                        android:layout_width="10dp"
                                        android:layout_height="match_parent" />

                                    <Button
                                        android:id="@+id/mextlanBTN"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="MEXTLAN"
                                        android:textSize="8sp" />
                                </LinearLayout>

                                <Button
                                    android:id="@+id/agrimexBTN"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AGRIMEX"
                                    android:textSize="8sp" />

                            </LinearLayout>

                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/textView8"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="PROVEEDOR"
                                    android:textSize="20sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <Button
                                        android:id="@+id/rainfieldBTN"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Rainfield"
                                        android:textSize="8sp" />

                                    <Space
                                        android:layout_width="10dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1" />

                                    <Button
                                        android:id="@+id/coastalBTN"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Coastal"
                                        android:textSize="8sp" />
                                </LinearLayout>

                                <Button
                                    android:id="@+id/muranakaBTN"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Muranaka"
                                    android:textSize="8sp" />

                            </LinearLayout>
                        </FrameLayout>

                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>

            <FrameLayout
                android:id="@+id/divisor1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#3F51B5">

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="10dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tarimasET"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TARIMAS"
                                android:textSize="20sp" />

                            <EditText
                                android:id="@+id/tarimasEDTXT"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:ems="10"
                                android:inputType="number"
                                android:text="1"
                                android:textAlignment="center" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/unidadesET"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PIEZAS"
                                android:textSize="20sp" />

                            <EditText
                                android:id="@+id/piezasEDTXT"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:ems="10"
                                android:inputType="number"
                                android:text="1"
                                android:textAlignment="center" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/piezasET"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CAJAS"
                                android:textSize="20sp" />

                            <EditText
                                android:id="@+id/cajasEDTXT"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:ems="10"
                                android:inputType="number"
                                android:text="1"
                                android:textAlignment="center" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <Space
                                android:id="@+id/sueltoSPC1"
                                android:layout_width="50dp"
                                android:layout_height="wrap_content"
                                android:visibility="visible" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/totalET"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TOTAL"
                                    android:textSize="20sp" />

                                <TextView
                                    android:id="@+id/totalTXT"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:text="1"
                                    android:textAlignment="center"
                                    android:textSize="18sp" />

                            </LinearLayout>

                            <Button
                                android:id="@+id/sueltoBTN"
                                android:layout_width="36dp"
                                android:layout_height="35dp"
                                android:background="@drawable/icon_mas" />

                            <Space
                                android:id="@+id/sueltoSPC2"
                                android:layout_width="15dp"
                                android:layout_height="wrap_content"
                                android:visibility="visible" />

                            <LinearLayout
                                android:id="@+id/sueltoLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/textView2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="SUELTO"
                                    android:textAlignment="center"
                                    android:textSize="20sp" />

                                <EditText
                                    android:id="@+id/sueltoEDTXT"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ems="10"
                                    android:inputType="number"
                                    android:textAlignment="center" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/divisor2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#3F51B5">

            <Space
                android:layout_width="wrap_content"
                android:layout_height="10dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="125dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="5dp">

                <Button
                    android:id="@+id/atrasBTN"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/ic_navigate_before"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/delanteBTN"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/ic_navigate_next"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/listaRegistrosBTN"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/ic_ad_97607"
                    android:visibility="visible" />

                <Space
                    android:id="@+id/spacebotonesAct1"
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <Space
                    android:id="@+id/spacebotonesReg1"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/guardarBTN"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/save_33" />

                <Space
                    android:id="@+id/spacebotonesAct2"
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <Space
                    android:id="@+id/spacebotonesReg2"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/nuevoBTN"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/nuevoregistro"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>